#!/usr/bin/env bash
#
# Boots example/ as a repository taking this one would be: a copy of it, with a
# copy of this tree as its lib/design-tools submodule, linked by the commands
# README.md, Setting up a repository, gives, then built, gated and previewed
# through Docker. Runs from this repository's root, on the host.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

die() {
    echo "example-boot: $*" >&2
    exit 1
}

root=$(pwd)
if [ ! -f "$root/design.mk" ] || [ ! -d "$root/example" ]; then
    die "run from the root of lib-design-tools"
fi

# Named for the checkout, so worktrees booting at once keep their own images.
COMPOSE_PROJECT_NAME="$(basename "$root")-example"
export COMPOSE_PROJECT_NAME

mkdir -p "$root/tmp"
work=$(mktemp -d "$root/tmp/example.XXXXXX")
[[ $work == "$root/tmp/example."?????? ]] || die "unexpected work directory $work"
consumer=$work/consumer

function cleanup {
    if [ -f "$consumer/docker-compose.yml" ]; then
        # Reported rather than fatal, so the work directory still goes.
        (cd "$consumer" && docker compose down --remove-orphans) ||
            echo "example-boot: docker compose down failed" >&2
    fi
    echo "removing $work" >&2
    rm -rf -- "$work"
}
trap cleanup EXIT

echo -e "\n=== ASSEMBLE $consumer\n"

mkdir -p "$consumer/lib/design-tools"
cp -a "$root/example/." "$consumer/"
# What a recursive clone holds, less local state.
tar -C "$root" --exclude=.git --exclude=./tmp --exclude=./.env \
    --exclude=__pycache__ -cf - . |
    tar -C "$consumer/lib/design-tools" -xf -

cd "$consumer"

ln -s lib/design-tools/Dockerfile Dockerfile
mkdir -p bin
for runner in format lint test preview; do
    ln -s "../lib/design-tools/bin/$runner" "bin/$runner"
done

echo -e "\n=== BUILD\n"

make build

echo -e "\n=== GATE\n"

make test

echo -e "\n=== PREVIEW\n"

docker compose up --detach --wait preview
address=$(docker compose port preview 8080)
port=${address##*:}
[[ $port =~ ^[0-9]+$ ]] || die "no published port in '$address'"

page=$(curl --fail --silent --show-error --location \
    "http://127.0.0.1:$port/")
grep -qF '<ul id="swatches">' <<< "$page" ||
    die "the preview at port $port did not serve the example page"
echo "served the example page at port $port" >&2

echo
