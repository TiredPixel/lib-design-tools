#!/usr/bin/env bash
#
# The gate: bin/lint, then the tests. Runs from the root of the repository.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=${0##*/}
dir=$(dirname "$(dirname "$(readlink -f "$0")")")
# shellcheck source=SCRIPTDIR/../lib/shell-common/testing/common
source "$dir/lib/shell-common/testing/common"
# shellcheck source=SCRIPTDIR/../lib/shell-common/runner/core
source "$dir/lib/shell-common/runner/core"

python_tests=("$@")

if [ $# -gt 0 ] && ! defines pytest_args; then
    echo "$prog: bin/settings: pytest_args is not set," \
        "so there are no tests to name" >&2
    exit 1
fi

failed=()
if [ $# -eq 0 ]; then
    # Skipped for named tests: the lint covers the whole tree, so it costs far
    # more than they do.
    bin/lint
fi

if defines pytest_args; then
    options=()
    collect options --may-be-empty pytest_args
    echo "$prog: running pytest" >&2
    # shellcheck disable=SC2154 # Set by bin/settings, which runner/core sources.
    PYTHONPATH=$tools pytest -p pytest_no_skips "${options[@]}" \
        "${python_tests[@]}" || failed+=(python)
fi

if [ ${#failed[@]} -gt 0 ]; then
    echo "$prog: failed: ${failed[*]}" >&2
    exit 1
fi
