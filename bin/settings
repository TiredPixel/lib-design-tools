# shellcheck shell=bash
#
# This repository's settings for the runners in bin/, which it uses as any other
# repository does: each function names what one pass reads, NUL-separated.
#
# No pass reaches pytest.ini, checkmake.ini, .gitmodules, .gitignore,
# .dockerignore, .dockerrepo or LICENSE, since the image has no formatter or
# linter for INI, git config, ignore or plain-text files. Nor does any reach the
# locks docker/upgrade writes whole: Dockerfile.lock/*/requirements.txt, and
# Dockerfile.lock/js/package-lock.json, in npm's own key order.

# A proposed workflow waits in .github/workflows.new/ until it is moved into
# .github/workflows/, so either directory, though not both, may be empty or
# absent.
function workflow_files {
    find .github -path '.github/workflows*/*.yml' -print0 | sort -z
}

function yaml_files {
    printf '%s\0' .hadolint.yaml .yamllint.yaml docker-compose.yml
    workflow_files
}

function dotenv_files {
    printf '%s\0' .env.example
}

function json_files {
    printf '%s\0' Dockerfile.lock/js/package.json
}

function compose_files {
    printf '%s\0' docker-compose.yml
}

function docker_files {
    printf '%s\0' Dockerfile
}

function make_files {
    printf '%s\0' Makefile common.mk
}

function md_files {
    printf '%s\0' README.md
}

function toml_files {
    printf '%s\0' ruff.toml
}

# By shebang, since the commands in tools/ carry no suffix.
function tools_by_shebang {
    local f first
    local pattern="^#!.*[/[:space:]]$1([[:space:]]|\$)"

    for f in tools/*; do
        [ -f "$f" ] || continue
        first=$(head -n 1 -- "$f")
        if [[ $first =~ $pattern ]]; then
            printf '%s\0' "$f"
        fi
    done
}

function python_files {
    tools_by_shebang python3
    printf '%s\0' tools/*.py test/*.py test/*/*.py
}

# The shell in tools/, and all of bin/: the runners, and bin/runner and this
# file, which carry no shebang since they are sourced.
function shell_files {
    tools_by_shebang bash
    printf '%s\0' bin/*
}

function pytest_args {
    printf '%s\0' --no-skips
}
