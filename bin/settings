# shellcheck shell=bash
# Left untooled: INI and its dialects, ignore and plain-text files, and files
# a tool writes whole.

# The design passes, run here as in a repository that takes this one.
# shellcheck source=SCRIPTDIR/layer
source bin/layer

shell_files() {
    files_shebang bash bin tools
}

docker_files() {
    printf '%s\0' Dockerfile
}

compose_files() {
    printf '%s\0' docker-compose.yml
}

make_files() {
    printf '%s\0' Makefile common.mk
}

yaml_files() {
    printf '%s\0' .hadolint.yaml .yamllint.yaml docker-compose.yml
}

json_files() {
    printf '%s\0' Dockerfile.lock/js/package.json
}

toml_files() {
    printf '%s\0' .mdformat.toml coverage.toml ruff.toml
}

md_files() {
    printf '%s\0' README.md
}

dotenv_files() {
    printf '%s\0' .env.example
}

python_files() {
    files_shebang python3 tools
    files_sorted test tools -type f -name '*.py'
}

pytest_args() {
    printf '%s\0' --no-skips
}
