#!/usr/bin/env bash
#
# Serves the tree with tools/preview-serve on every address, so the port the
# preview service publishes reaches it from the host. / redirects to the
# preview_start bin/settings sets.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=${0##*/}

usage() {
    echo "Usage: $prog" >&2
    exit 2
}

[ $# -eq 0 ] || usage

dir=$(dirname "$(dirname "$(readlink -f "$0")")")
# shellcheck source=SCRIPTDIR/../lib/shell-common/runner/core
source "$dir/lib/shell-common/runner/core"
# Unlike the other settings, a variable rather than a function.
if declare -F preview_start >/dev/null; then
    echo "$prog: bin/settings: preview_start must be a variable, not a function" >&2
    exit 1
fi
if [ -z "${preview_start:-}" ]; then
    echo "$prog: bin/settings: preview_start is not set" >&2
    exit 1
fi

# shellcheck disable=SC2154 # Set by bin/settings, which runner/core sources.
exec "$tools/preview-serve" --address=0.0.0.0 --port=8080 --root=. \
    --start="$preview_start"
