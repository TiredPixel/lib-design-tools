#!/usr/bin/env bash
#
# Serves the tree with tools/preview-serve on every address, so the port the
# preview service publishes reaches it from the host. / redirects to the
# preview_index bin/settings sets.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

# Not followed, since a repository linking this runner has no bin/runner beside
# the link for ShellCheck to find; bin/runner is linted on its own.
# shellcheck source=/dev/null
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/runner"

# Unlike the other settings, a variable rather than a function.
if declare -F preview_index > /dev/null; then
    echo "bin/settings: preview_index must be a variable, not a function" >&2
    exit 1
fi
if [ -z "${preview_index:-}" ]; then
    echo "bin/settings: preview_index is not set" >&2
    exit 1
fi

# tools comes from bin/runner, which ShellCheck does not follow.
# shellcheck disable=SC2154
exec "$tools/preview-serve" --address=0.0.0.0 --port=8080 --root=. \
    --index="$preview_index"
