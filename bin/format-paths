# shellcheck shell=bash
#
# This repository's settings for the runners in bin/, which it uses as any
# consumer does: each function names what one pass reads, NUL-separated.

# A proposed workflow waits in .github/workflows.new/ until it is moved into
# .github/workflows/, so either directory may be empty or absent.
function yaml_files {
    printf '%s\0' compose.gate.yml compose.preview.yml docker-compose.yml
    find .github -path '.github/workflows*/*.yml' -print0 | sort -z
}

# By shebang, since the commands in tools/ carry no suffix, and file(1) types
# some of them by the HTML they quote, as text/html.
function tools_by_shebang {
    local f first
    local pattern="^#!.*[/[:space:]]$1([[:space:]]|\$)"

    for f in tools/*; do
        [ -f "$f" ] || continue
        first=$(head -n 1 -- "$f")
        if [[ $first =~ $pattern ]]; then
            printf '%s\0' "$f"
        fi
    done
}

function python_files {
    tools_by_shebang python3
    printf '%s\0' tools/*.py test/*.py
}

# The shell in tools/, and bin/runner, which carries no shebang since it is
# sourced.
function shell_files {
    tools_by_shebang bash
    printf '%s\0' bin/runner
}

# The README and the guide document a consumer's paths, which live in the
# consumer.
function markdown_args {
    printf '%s\0' \
        --ignore-path 'lib/design-tools' \
        --ignore-path 'lib/design-tools/*' \
        README.md docs/*.md
}

# Every source tools/comment-check reads, Python and shell by shebang.
function comment_files {
    python_files
    tools_by_shebang bash
    printf '%s\0' bin/*
    yaml_files
}
