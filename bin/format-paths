# shellcheck shell=bash
#
# Read only by the scripts that source this one, so they look unused here.
# shellcheck disable=SC2034
#
# The path sets bin/format writes and bin/lint checks, sourced by each so they
# cannot disagree.

# A proposed workflow waits in .github/workflows.new/ until it is moved into
# .github/workflows/, so either directory may be empty or absent.
function yaml_paths {
    printf '%s\0' docker-compose.yml
    find .github -path '.github/workflows*/*.yml' -print0 | sort -z
}

# By content, not extension: the commands in tools/ carry no .py suffix. file(1)
# runs on its own so a failure is not swallowed by the pipeline.
function tools_typed {
    local typed

    typed=$(file --mime-type tools/*)

    grep "$1" <<< "$typed" | cut -d':' -f1 | tr '\n' '\0' || true
}

function python_files {
    tools_typed 'text/x-script.python'

    # By name, since file(1) answers text/plain for a module without a shebang.
    printf '%s\0' tools/*.py test/*.py
}

# The shell in tools/, which shell-common's lint does not reach on its own.
function tools_shell_files {
    tools_typed 'text/x-shellscript'
}

# By shebang, for a set file(1) cannot give: it types html-embedded and
# references-check as text/html.
function tools_by_shebang {
    local f first
    local pattern="^#!.*[/[:space:]]$1([[:space:]]|\$)"

    for f in tools/*; do
        [ -f "$f" ] || continue
        first=$(head -n 1 -- "$f")
        if [[ $first =~ $pattern ]]; then
            printf '%s\0' "$f"
        fi
    done
}

# Every source tools/comment-check reads, Python and shell by shebang.
function comment_files {
    tools_by_shebang python3
    printf '%s\0' tools/*.py test/*.py
    tools_by_shebang bash
    printf '%s\0' bin/*
    yaml_paths
}

function markdown_files {
    printf '%s\0' README.md
}
