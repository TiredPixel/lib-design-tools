# shellcheck shell=bash
#
# Sourced by bin/format, bin/lint, bin/test and bin/preview, which run from the
# root of the repository they serve. That repository's bin/ holds symlinks to
# them, so this one is found by resolving the link, and its own bin/settings
# turns each pass on by defining what the pass reads (README.md, Settings).
# Nothing runs that bin/settings does not name.
#
# Read only by the runners that source this one, so they look unused here.
# shellcheck disable=SC2034

design_tools=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")
tools=$design_tools/tools

source bin/settings

# Read by bin/format and bin/lint alike, so the two cannot disagree.
json_options=(--indent 2 --sort-keys --no-ensure-ascii)

function defines {
    declare -F "$1" > /dev/null || declare -p "$1" > /dev/null 2>&1
}

# Reads the NUL-separated output of the function named by $1 into the array
# named by $2. The function's status is checked through wait, since a process
# substitution's own failure would otherwise pass unseen. An empty result fails
# too, unless $3 is "may-be-empty": a set of files that is defined and names
# nothing is a mistake, never a clean pass.
function read_set {
    local -n into=$2

    mapfile -t -d '' into < <("$1")
    wait $! || {
        echo "bin/settings: $1 failed" >&2
        exit 1
    }
    if [ ${#into[@]} -eq 0 ] && [ "${3:-}" != may-be-empty ]; then
        echo "bin/settings: $1 names nothing" >&2
        exit 1
    fi
}
