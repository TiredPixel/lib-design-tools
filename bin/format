#!/usr/bin/env bash
#
# Writing counterpart to bin/lint: every pass here rewrites, and bin/lint checks
# the same path set for drift afterwards.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

source bin/format-paths

echo -e "\n=== FORMAT PYTHON\n"

mapfile -t -d '' python < <(python_files)

echo "formatting ${#python[@]} Python file(s)" >&2

ruff check --fix --unsafe-fixes "${python[@]}"
ruff format "${python[@]}"

echo -e "\n=== FORMAT YAML\n"

# Named as they are rewritten, so the pass records what it covered.
while IFS= read -r -d '' f; do
    yq -i -P 'sort_keys(..)' "$f"
    echo "  $f" >&2
done < <(yaml_paths)

echo
