#!/usr/bin/env bash
#
# Writing counterpart to bin/lint: every pass here rewrites, and bin/lint checks
# the same path sets for drift afterwards.
#
# ShellCheck sees no assignment for the names bin/runner sets, since it does not
# follow bin/runner, nor for the arrays read_set and the readers built on it
# assign through a nameref, which it cannot follow.
# shellcheck disable=SC2154
set -Eeuo pipefail
shopt -s inherit_errexit failglob

# Not followed, since a repository linking this runner has no bin/runner beside
# the link for ShellCheck to find; bin/runner is linted on its own.
# shellcheck source=/dev/null
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/runner"

# Each tool's failure is recorded here and the run carries on, so a finding no
# tool can fix, or a file a formatter cannot parse, leaves no later pass's files
# unformatted; the run fails once every pass has run.
status=0

if defines palette_args; then
    echo -e "\n=== FORMAT PALETTE\n"

    read_set palette_args palette
    "$tools/palette-generate" "${palette[@]}" || status=1
fi

if defines shell_files; then
    echo -e "\n=== FORMAT SHELL\n"

    read_files shell_files shell
    echo "formatting ${#shell[@]} shell file(s)" >&2
    shfmt "${shfmt_args[@]}" -w "${shell[@]}" || status=1
fi

if defines python_files; then
    echo -e "\n=== FORMAT PYTHON\n"

    read_files python_files python
    echo "formatting ${#python[@]} Python file(s)" >&2
    ruff check --fix "${python[@]}" || status=1
    ruff format "${python[@]}" || status=1
fi

if defines yaml_files; then
    echo -e "\n=== FORMAT YAML\n"

    read_files yaml_files yaml
    echo "formatting ${#yaml[@]} YAML file(s)" >&2
    # -P, since yq otherwise keeps each value's flow or block style and quoting,
    # so the same data could pass in several layouts; jq gives JSON one layout
    # by default.
    for f in "${yaml[@]}"; do
        yq -i -P 'sort_keys(..)' "$f" || status=1
    done
fi

if defines json_files; then
    echo -e "\n=== FORMAT JSON\n"

    read_files json_files json
    echo "formatting ${#json[@]} JSON file(s)" >&2
    # Captured before writing, since redirecting jq's output to the file it
    # reads would truncate it before reading; a file jq cannot read is left as
    # it is.
    for f in "${json[@]}"; do
        if formatted=$(jq "${jq_args[@]}" "$f"); then
            printf '%s\n' "$formatted" >"$f"
        else
            status=1
        fi
    done
fi

if defines js_files; then
    echo -e "\n=== FORMAT JAVASCRIPT\n"

    read_files js_files js
    echo "formatting ${#js[@]} JavaScript file(s)" >&2
    semistandard --fix "${js[@]}" || status=1
fi

if defines css_files || defines html_files; then
    echo -e "\n=== FORMAT CSS AND HTML\n"

    read_prettier_files prettied
    echo "formatting ${#prettied[@]} CSS and HTML file(s)" >&2
    prettier --write "${prettied[@]}" || status=1
fi

if defines md_files; then
    echo -e "\n=== FORMAT MARKDOWN\n"

    read_files md_files md
    echo "formatting ${#md[@]} Markdown file(s)" >&2
    mdformat "${mdformat_args[@]}" "${md[@]}" || status=1
fi

if defines toml_files; then
    echo -e "\n=== FORMAT TOML\n"

    read_files toml_files toml
    echo "formatting ${#toml[@]} TOML file(s)" >&2
    taplo fmt "${toml[@]}" || status=1
fi

if defines docker_files; then
    echo -e "\n=== FORMAT DOCKER\n"

    read_files docker_files docker
    echo "formatting ${#docker[@]} Docker file(s)" >&2
    dockerfmt "${dockerfmt_args[@]}" --write "${docker[@]}" || status=1
fi

echo
exit "$status"
