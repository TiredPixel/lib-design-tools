#!/usr/bin/env bash
#
# kcov traces a script only where the descriptor BASH_XTRACEFD names is open to
# it: Python's subprocess closes it in a child, so a script a test starts is
# measured only where the test passes it on with pass_fds.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=${0##*/}
dir=$(dirname "$(dirname "$(readlink -f "$0")")")
# shellcheck source=SCRIPTDIR/../lib/shell-common/testing/common
source "$dir/lib/shell-common/testing/common"
# shellcheck source=SCRIPTDIR/../lib/shell-common/runner/core
source "$dir/lib/shell-common/runner/core"

if [ $# -gt 0 ] && ! defines pytest_args; then
    echo "$prog: bin/settings: pytest_args is not set," \
        "so there are no tests to name" >&2
    exit 1
fi

# The tar alone goes to stdout.
exec 3>&1 1>&2

COVERAGE_RUN_DIR=$(mktemp -d)
trap 'rm -rf -- "$COVERAGE_RUN_DIR"' EXIT
export COVERAGE_ROOT=$PWD COVERAGE_RUN_DIR
report=$COVERAGE_RUN_DIR/report
mkdir -- "$COVERAGE_RUN_DIR/python" "$report"

# This repository's own submodules, under lib/, measure their own coverage.
if [ "$dir" = "$PWD" ]; then
    exclude=$PWD/lib
else
    exclude=$dir
fi

rc=0
if defines pytest_args; then
    options=()
    collect options --may-be-empty pytest_args
    # kcov runs a script, so the tests start from one.
    cat >"$COVERAGE_RUN_DIR/suites" <<'SUITES'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
exec "$@"
SUITES
    chmod +x -- "$COVERAGE_RUN_DIR/suites"
    echo "$prog: running pytest" >&2
    # shellcheck disable=SC2154 # Set by bin/settings, which runner/core sources.
    PYTHONPATH=$tools NODE_V8_COVERAGE=$COVERAGE_RUN_DIR/js \
        kcov --include-path="$PWD" --exclude-path="$exclude" "$report/shell" \
        "$COVERAGE_RUN_DIR/suites" pytest -p pytest_no_skips \
        --cov --cov-config="$dir/coverage.toml" --cov-report=html \
        --cov-report=term-missing "${options[@]}" "$@" || rc=$?
fi

# Node makes the directory with the first file it writes, so there is none
# where no Node ran under the tests.
if [ -d "$COVERAGE_RUN_DIR/js" ]; then
    # Every option c8 report reads, given with --config, so no setting of the
    # repository's own changes the report; NODE_V8_COVERAGE empty, so c8, itself
    # run by Node, writes no data of its own.
    jq -n \
        --arg data "$COVERAGE_RUN_DIR/js" \
        --arg reports "$report/js" \
        '{
            "100": false,
            "all": false,
            "allowExternal": false,
            "check-coverage": false,
            "exclude": [],
            "exclude-after-remap": false,
            "exclude-node-modules": true,
            "experimental-monocart": false,
            "extension": [],
            "include": [],
            "merge-async": false,
            "omit-relative": true,
            "reporter": ["html"],
            "reporter-options": {},
            "reports-dir": $reports,
            "resolve": "",
            "skip-full": false,
            "temp-directory": $data,
            "wrapper-length": 0
        }' >"$COVERAGE_RUN_DIR/c8.json"
    NODE_V8_COVERAGE='' EXPERIMENTAL_MONOCART='' \
        c8 --config="$COVERAGE_RUN_DIR/c8.json" report
fi

# kcov links a run's name to its directory by an absolute path, which would
# dangle once the report leaves the container, so each such link is made
# relative.
find "$report" -type l -print0 >"$COVERAGE_RUN_DIR/links"
while IFS= read -r -d '' l <&4; do
    target=$(readlink -- "$l")
    if [[ $target == "$report"/* ]]; then
        target=$(realpath -ms --relative-to="$(dirname -- "$l")" -- "$target")
        ln -sfn -- "$target" "$l"
    fi
done 4<"$COVERAGE_RUN_DIR/links"

{
    printf '%s\n' '<!DOCTYPE html>' '<html lang="en">' \
        '<head><meta charset="utf-8"><title>Coverage</title></head>' \
        '<body><ul>'
    # Through find, since failglob would fail a glob where no report was
    # written, as where bin/settings defines no pytest_args.
    find "$report" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' |
        LC_ALL=C sort |
        while IFS= read -r kind; do
            printf '<li><a href="%s/index.html">%s</a></li>\n' "$kind" "$kind"
        done
    printf '%s\n' '</ul></body>' '</html>'
} >"$report/index.html"

cd -- "$report"
{
    find . -mindepth 1 -maxdepth 1 ! -name index.html -print0
    printf '%s\0' ./index.html
} | tar --null -T - -cf - >&3
exit "$rc"
