#!/usr/bin/env bash
#
# Fail unless every named stylesheet opens with @charset "UTF-8";, the one
# declaration a browser reads before guessing an encoding.
#
#   charset-check FILE...
set -Eeuo pipefail
shopt -s inherit_errexit failglob

[ $# -gt 0 ] || { echo "usage: charset-check FILE..." >&2; exit 2; }

expected='@charset "UTF-8";'
status=0

for f in "$@"; do
    first=$(head -n 1 -- "$f")
    if [ "$first" != "$expected" ]; then
        echo "$f:1: opens '$first', not '$expected'" >&2
        status=1
    fi
done

echo "checked $# stylesheet(s)" >&2

exit $status
