#!/usr/bin/env bash
#
# Generate a palette's JSON and CSS from its YAML, the one source.
#
#   palette-generate YAML --prefix P --json OUT --css OUT [--check]
#
# The JSON is the YAML as data, aliases and merge keys expanded, in the YAML's
# key order, opening with a $comment naming its source. The CSS holds one custom
# property per colour leaf of that same data (a string #RGB, #RGBA, #RRGGBB or
# #RRGGBBAA), named --P- and the leaf's full key path, lowercased, with _ as -
# and list items numbered from 1, in the YAML's order. A leaf with no value, as
# an unquoted colour gives, fails the run, as does any other string starting
# with #. Two leaves that would share a name fail the run, as do a name holding
# anything but ASCII letters and digits, hyphens and non-ASCII characters, which
# CSS would not read as one name, and a YAML holding no colour at all. Nothing
# in either output depends on the clock or the environment, so a rerun on an
# unchanged YAML changes nothing.
#
# --check writes nothing: it generates into a temporary directory and fails,
# with a diff, where either output differs from what is on disk.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

synopsis="usage: palette-generate YAML --prefix P --json OUT --css OUT [--check]"

usage() {
    echo "$synopsis" >&2
    exit 2
}

die() {
    echo "palette-generate: $*" >&2
    exit 1
}

yaml=""
prefix=""
json=""
css=""
check=false

while [ $# -gt 0 ]; do
    case $1 in
    --prefix)
        [ $# -ge 2 ] || usage
        prefix=$2
        shift 2
        ;;
    --json)
        [ $# -ge 2 ] || usage
        json=$2
        shift 2
        ;;
    --css)
        [ $# -ge 2 ] || usage
        css=$2
        shift 2
        ;;
    --check)
        check=true
        shift
        ;;
    --help | -h)
        echo "$synopsis"
        exit 0
        ;;
    -*) usage ;;
    *)
        [ -z "$yaml" ] || usage
        yaml=$1
        shift
        ;;
    esac
done

if [ -z "$yaml" ] || [ -z "$prefix" ] || [ -z "$json" ] || [ -z "$css" ]; then
    usage
fi
[[ $prefix =~ ^[a-z][a-z0-9-]*$ ]] || die "prefix '$prefix' is not a CSS name"
[ -f "$yaml" ] || die "$yaml: no such file"

out=$(mktemp -d)
trap 'rm -rf -- "$out"' EXIT

colour='^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$'
notice="Generated from $yaml, in its key order: edit that file, never this one."

# Both outputs and the checks read the YAML with its aliases and << merge keys
# expanded, which yq does only where asked, so the CSS holds every colour the
# JSON does; merge keys follow the YAML spec, a key of the mapping's own
# winning over a merged one.
# $comment is the JSON key, written literally, not a shell variable.
# shellcheck disable=SC2016
COMMENT=$notice \
    yq --yaml-fix-merge-anchor-to-spec -o=json -I2 \
    'explode(.) | {"$comment": strenv(COMMENT)} + .' "$yaml" >"$out/json"

# Runs the yq filter given on every node of the expanded YAML. Lists become
# maps keyed from 1 first, so a list position and a mapping key both reach the
# name through the same path.
nodes() {
    COLOUR=$colour PREFIX=$prefix yq --yaml-fix-merge-anchor-to-spec '
        explode(.)
        | (.. | select(tag == "!!seq")) |= (to_entries | map(.key += 1) | from_entries)
        | ..
        | '"$1" "$yaml"
}

# A null leaf is most often an unquoted colour, which YAML reads as a comment.
nulls=$(nodes 'select(tag == "!!null") | "  " + (path | join("."))')
[ -z "$nulls" ] || die "$yaml: leaves with no value; quote a colour, since YAML reads an unquoted # as a comment:"$'\n'"$nulls"

malformed=$(nodes 'select(tag == "!!str" and test("^#") and (test(strenv(COLOUR)) | not))
    | "  " + (path | join(".")) + ": " + @json')
[ -z "$malformed" ] || die "$yaml: leaves starting with # that are not a #RGB, #RGBA, #RRGGBB or #RRGGBBAA colour:"$'\n'"$malformed"

nodes 'select(tag == "!!str" and test(strenv(COLOUR)))
    | "  --" + strenv(PREFIX) + "-" + (path | join("-") | downcase | sub("_"; "-")) + ": " + . + ";"' \
    >"$out/properties"

[ -s "$out/properties" ] || die "$yaml holds no colour"

# grep exits 1 when every line matches, and 2 on an error of its own.
status=0
invalid=$(grep -vP '^  --(?:[a-z0-9-]|[^\x00-\x7F])+: #[0-9A-Fa-f]+;$' \
    "$out/properties") || status=$?
[ $status -le 1 ] || die "grep failed reading the generated properties"
[ -z "$invalid" ] || die "$yaml: keys making names CSS cannot read:"$'\n'"$invalid"

collisions=$(cut -d':' -f1 "$out/properties" | sort | uniq -d)
[ -z "$collisions" ] || die "$yaml: leaves sharing a name:"$'\n'"$collisions"

{
    echo '@charset "UTF-8";'
    echo "/* $notice */"
    echo ':root {'
    cat "$out/properties"
    echo '}'
} >"$out/css"

if $check; then
    status=0
    diff -u -- "$json" "$out/json" || status=1
    diff -u -- "$css" "$out/css" || status=1
    [ $status -eq 0 ] || die "$json or $css is stale against $yaml"
    exit 0
fi

cat -- "$out/json" >"$json"
cat -- "$out/css" >"$css"
