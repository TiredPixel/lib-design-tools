#!/usr/bin/env python3
"""Serve a tree as it is on disk, for previewing it while it is edited.

Every response carries ``Cache-Control: no-store``, so a reload always shows the file as
saved. A directory without an ``index.html`` or ``index.htm`` is listed. ``/`` is
redirected to ``--start``, the page a preview opens on. A path ``design_render.refused``
names, such as one through ``.git``, is answered 404. ``.webmanifest`` is served as
``application/manifest+json``, which a browser needs to read a web app manifest rather
than download it.

For development only: the server is Python's standard one, threaded, with no TLS and no
access control.

Exit status: 0 when stopped, 2 on a usage error.
"""

from __future__ import annotations

import argparse
import functools
import http.server
import pathlib
import sys
import urllib.parse
from typing import ClassVar

import design_render

MANIFEST_TYPE = "application/manifest+json"
EXTRA_TYPES = {".webmanifest": MANIFEST_TYPE}


class PreviewHandler(http.server.SimpleHTTPRequestHandler):
    """Serves ``directory`` with the rules above; ``start`` is where ``/`` goes."""

    extensions_map: ClassVar[dict[str, str]] = {
        **http.server.SimpleHTTPRequestHandler.extensions_map,
        **EXTRA_TYPES,
    }

    def __init__(self, *args, start: str, **kwargs):
        self.start = start
        super().__init__(*args, **kwargs)

    def end_headers(self) -> None:
        self.send_header("Cache-Control", "no-store")
        super().end_headers()

    def _route(self) -> bool:
        """Answer the redirect and refusals; return True when answered."""
        if urllib.parse.urlsplit(self.path).path == "/":
            self.send_response(302)
            self.send_header("Location", self.start)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return True
        if design_render.refused(
            self.directory, self.path, self.translate_path(self.path)
        ):
            self.send_error(404)
            return True
        return False

    def do_GET(self) -> None:
        if not self._route():
            super().do_GET()

    def do_HEAD(self) -> None:
        if not self._route():
            super().do_HEAD()

    def guess_type(self, path) -> str:
        guessed = super().guess_type(path)
        if guessed.startswith("text/") or guessed in (
            "application/javascript",
            "application/json",
            MANIFEST_TYPE,
            "image/svg+xml",
        ):
            return f"{guessed}; charset=utf-8"
        return guessed


def make_server(
    root: pathlib.Path, address: str, port: int, start: str
) -> http.server.ThreadingHTTPServer:
    """A server for ``root`` bound to ``address`` and ``port`` (0 picks one)."""
    handler = functools.partial(PreviewHandler, directory=str(root), start=start)
    return http.server.ThreadingHTTPServer((address, port), handler)


def resolved_path(start: str) -> str:
    """The path a browser requests for a Location of ``start``.

    A browser reads ``\\`` as ``/`` and ``%2e`` as ``.``, then removes dot segments, so
    ``/a/..`` and ``/%2e/`` both reach ``/``.
    """
    browser_form = start.replace("\\", "/").replace("%2e", ".").replace("%2E", ".")
    return urllib.parse.urlsplit(
        urllib.parse.urljoin("http://host/", browser_form)
    ).path


def parse_arguments(argv: list[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        formatter_class=design_render.UsageFormatter,
        prog="preview-serve",
        description="Serve a tree as it is on disk, for previewing it.",
    )
    parser.add_argument(
        "--root", type=pathlib.Path, required=True, help="the tree to serve"
    )
    parser.add_argument(
        "--address", default="127.0.0.1", help="the address to listen on"
    )
    parser.add_argument("--port", type=int, default=8080, help="the port to listen on")
    parser.add_argument(
        "--start",
        required=True,
        help="the page the preview opens on, which / redirects to, such as /preview/",
    )
    arguments = parser.parse_args(argv)
    if not arguments.root.is_dir():
        parser.error(f"--root {arguments.root} is not a directory")
    if not arguments.start.startswith("/"):
        parser.error(f"--start {arguments.start} is not a /-rooted path")
    # send_header checks nothing, so a control character would corrupt the header, and
    # it encodes the header as Latin-1, so a character above U+00FF fails every request
    # for / and one from U+0080 goes out as a raw byte rather than percent-encoded.
    if not (arguments.start.isascii() and arguments.start.isprintable()):
        parser.error(
            f"--start {arguments.start!r} holds a character outside printable ASCII;"
            " percent-encode it"
        )
    # A browser reads a Location opening with two of / or \ as another host's, so /
    # would redirect off the server.
    leading = arguments.start[:2]
    if len(leading) == 2 and all(character in "/\\" for character in leading):
        parser.error(f"--start {arguments.start} names another host")
    if resolved_path(arguments.start) == "/":
        parser.error(
            f"--start {arguments.start} resolves to /, which would redirect to itself"
        )
    if not 0 <= arguments.port <= 65535:
        parser.error(f"--port {arguments.port} is not a port")
    return arguments


def main(argv: list[str] | None = None) -> int:
    arguments = parse_arguments(argv)
    server = make_server(
        arguments.root.resolve(), arguments.address, arguments.port, arguments.start
    )
    host, port = server.server_address[:2]
    print(
        f"preview-serve: {arguments.root} at http://{host}:{port}/",
        file=sys.stderr,
        flush=True,
    )
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
