#!/usr/bin/env python3
"""Format, or check the formatting of, the scripts and styles inside HTML files.

Each inline ``<script>`` without ``src`` whose ``type`` is absent, empty,
``text/javascript`` or ``module``, and each ``<style>``, is dedented and written to a
temporary file beside its HTML file, so the formatter finds the project's own
configuration. The command given for its language is run with that file's path appended
and must rewrite it in place, as ``prettier --write`` and ``semistandard --fix`` do. The
result is indented back to the block's original level and spliced in, leaving every byte
outside the blocks as it was. Scripts of any other type, such as ``text/babel``, are
left alone.

A block whose body sits on its own lines keeps its opening and closing lines and its
indentation exactly. A block written inline, such as ``<style>a{}</style>``, is laid out
on its own lines, one indent step deeper than the line holding its tag.

``format`` rewrites the files; ``check`` prints a unified diff of what ``format`` would
change and writes nothing.

Exit status: 0 when every block is formatted (or, for ``check``, already was), 1 when a
file is not valid UTF-8, a command fails on a block or ``check`` finds a difference, 2
on a usage error or when a command cannot be run.
"""

from __future__ import annotations

import argparse
import dataclasses
import difflib
import html.parser
import os
import pathlib
import re
import shlex
import subprocess
import sys
import tempfile

JAVASCRIPT_TYPES = frozenset({"", "module", "text/javascript"})

SUFFIXES = {"css": ".css", "js": ".js"}


class FormatError(Exception):
    """A formatter failed on a block, or produced output that cannot go back."""


class CommandError(Exception):
    """A formatter command cannot be run at all."""


@dataclasses.dataclass(frozen=True)
class Block:
    """The body of one embedded script or style, by character offset."""

    language: str
    tag: str
    start: int
    end: int
    line: int


def _line_starts(text: str) -> list[int]:
    return [0] + [index + 1 for index, char in enumerate(text) if char == "\n"]


class _BlockFinder(html.parser.HTMLParser):
    def __init__(self, text: str) -> None:
        super().__init__(convert_charrefs=True)
        self._starts = _line_starts(text)
        self._open: tuple[str, str | None, int, int] | None = None
        self.blocks: list[Block] = []

    def _offset(self) -> int:
        line, column = self.getpos()
        return self._starts[line - 1] + column

    def handle_starttag(self, tag: str, attrs: list) -> None:
        if tag not in ("script", "style"):
            return
        attributes = dict(attrs)
        language: str | None = "css"
        if tag == "script":
            kind = (attributes.get("type") or "").strip().lower()
            if "src" in attributes or kind not in JAVASCRIPT_TYPES:
                language = None
            else:
                language = "js"
        body_start = self._offset() + len(self.get_starttag_text())
        self._open = (tag, language, body_start, self.getpos()[0])

    def handle_endtag(self, tag: str) -> None:
        if self._open is None or tag != self._open[0]:
            return
        _, language, body_start, line = self._open
        self._open = None
        if language is not None:
            self.blocks.append(Block(language, tag, body_start, self._offset(), line))


def find_blocks(text: str) -> list[Block]:
    """Return the embedded blocks to format, in document order."""
    finder = _BlockFinder(text)
    finder.feed(text)
    finder.close()
    return finder.blocks


def _leading(line: str) -> str:
    return line[: len(line) - len(line.lstrip(" \t"))]


def _line_indent(text: str, offset: int) -> str:
    """Return the leading whitespace of the line holding ``offset``."""
    return _leading(text[text.rfind("\n", 0, offset) + 1 : offset])


def run_formatter(
    source: str, command: list[str], suffix: str, directory: pathlib.Path
) -> str:
    """Return ``source`` after ``command`` has rewritten it in a temporary file."""
    descriptor, name = tempfile.mkstemp(
        prefix="html-embedded-", suffix=suffix, dir=directory
    )
    path = pathlib.Path(name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(source)
        try:
            result = subprocess.run(
                [*command, str(path)], capture_output=True, text=True, check=False
            )
        except OSError as error:
            raise CommandError(f"cannot run {command[0]!r}: {error}") from error
        if result.returncode != 0:
            output = (result.stdout + result.stderr).strip() or "no output"
            output = output.replace(str(path), "<block>")
            raise FormatError(
                f"{shlex.join(command)} exited {result.returncode}: {output}"
            )
        return path.read_text(encoding="utf-8")
    finally:
        path.unlink(missing_ok=True)


def format_body(
    body: str,
    tag: str,
    tag_indent: str,
    command: list[str],
    suffix: str,
    directory: pathlib.Path,
) -> str:
    """Return ``body`` formatted and indented back to where it was."""
    newline = "\r\n" if "\r\n" in body else "\n"
    lines = body.replace("\r\n", "\n").split("\n")
    if len(lines) >= 2 and not lines[0].strip() and not lines[-1].strip():
        head, inner, tail = lines[0], lines[1:-1], lines[-1]
        indent = os.path.commonprefix(
            [_leading(line) for line in inner if line.strip()]
        )
        source = "\n".join(
            line[len(indent) :] if line.strip() else "" for line in inner
        )
    else:
        head, tail = "", tag_indent
        indent = tag_indent + ("\t" if "\t" in tag_indent else "  ")
        rest = lines[1:]
        if all(line.startswith(tag_indent) for line in rest if line.strip()):
            rest = [line[len(tag_indent) :] for line in rest]
        source = "\n".join([lines[0].strip(), *rest]).strip("\n")

    formatted = run_formatter(source + "\n", command, suffix, directory)
    formatted = formatted.replace("\r\n", "\n").strip("\n")
    if re.search(rf"</{tag}", formatted, re.IGNORECASE):
        raise FormatError(f"formatted <{tag}> would contain its own closing tag")
    out = [indent + line if line.strip() else "" for line in formatted.split("\n")]
    if not formatted.strip():
        out = []
    return newline.join([head, *out, tail])


def format_text(
    text: str,
    path: pathlib.Path,
    commands: dict[str, list[str]],
) -> tuple[str, list[tuple[Block, str]]]:
    """Return ``text`` with every block formatted, and the blocks that failed.

    When any block fails the text comes back unchanged, so a file is never left
    half-formatted.
    """
    pieces = []
    failures = []
    position = 0
    for block in find_blocks(text):
        body = text[block.start : block.end]
        pieces.append(text[position : block.start])
        position = block.end
        if not body.strip():
            pieces.append(body)
            continue
        try:
            pieces.append(
                format_body(
                    body,
                    block.tag,
                    _line_indent(text, block.start),
                    commands[block.language],
                    SUFFIXES[block.language],
                    path.parent,
                )
            )
        except FormatError as error:
            failures.append((block, str(error)))
    pieces.append(text[position:])
    if failures:
        return text, failures
    return "".join(pieces), failures


def parse_arguments(argv: list[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="html-embedded",
        description="Format or check the scripts and styles embedded in HTML.",
    )
    parser.add_argument("mode", choices=("format", "check"))
    parser.add_argument(
        "--js",
        required=True,
        metavar="CMD",
        help="command that rewrites a JavaScript file in place, path appended",
    )
    parser.add_argument(
        "--css",
        required=True,
        metavar="CMD",
        help="command that rewrites a CSS file in place, path appended",
    )
    parser.add_argument("files", nargs="+", type=pathlib.Path, metavar="FILE")
    arguments = parser.parse_args(argv)
    arguments.commands = {}
    for language in ("js", "css"):
        command = shlex.split(getattr(arguments, language))
        if not command:
            parser.error(f"--{language} is empty")
        arguments.commands[language] = command
    for path in arguments.files:
        if not path.is_file():
            parser.error(f"{path} is not a file")
    return arguments


def main(argv: list[str] | None = None) -> int:
    arguments = parse_arguments(argv)
    problems = 0
    changed = 0
    for path in arguments.files:
        original = path.read_bytes()
        try:
            text = original.decode("utf-8")
        except UnicodeDecodeError as error:
            print(f"{path}: not valid UTF-8: {error}", file=sys.stderr)
            problems += 1
            continue
        try:
            formatted, failures = format_text(text, path, arguments.commands)
        except CommandError as error:
            print(f"html-embedded: {error}", file=sys.stderr)
            return 2
        for block, message in failures:
            print(f"{path}:{block.line}: <{block.tag}>: {message}", file=sys.stderr)
        problems += len(failures)
        if failures or formatted == text:
            continue
        changed += 1
        if arguments.mode == "format":
            path.write_bytes(formatted.encode("utf-8"))
            continue
        problems += 1
        print(f"{path}: embedded code is not formatted", file=sys.stderr)
        sys.stdout.writelines(
            difflib.unified_diff(
                text.splitlines(keepends=True),
                formatted.splitlines(keepends=True),
                fromfile=str(path),
                tofile=f"{path} (formatted)",
            )
        )
    verb = "reformatted" if arguments.mode == "format" else "would reformat"
    print(
        f"checked {len(arguments.files)} file(s): {verb} {changed}, "
        f"{problems} problem(s)",
        file=sys.stderr,
    )
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
