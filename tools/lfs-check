#!/usr/bin/env bash
#
# Fail where a file that Git LFS should hold is still a pointer: a clone made
# without git-lfs, or a submodule whose objects were never pulled, leaves a
# small text file where a font or an image should be, and a browser fails on it
# quietly.
#
#   lfs-check --attributes FILE DIR... [--attributes FILE DIR...]...
#
# Each group checks its folders against its own attributes file, so a
# repository can check its own files and a submodule's in one run. The patterns
# are the filter=lfs lines of FILE, read as basename globs, which is how every
# pattern holding no slash matches in .gitattributes.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

synopsis="usage: lfs-check --attributes FILE DIR... [--attributes FILE DIR...]..."

usage() {
    echo "$synopsis" >&2
    exit 2
}

if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
    echo "$synopsis"
    exit 0
fi

die() {
    echo "lfs-check: $*" >&2
    exit 1
}

# Every group is read before any is checked, so a usage error stops the run
# before it reports anything. Group i's folders are dirs[starts[i]] onwards,
# lengths[i] of them.
attributes=()
starts=()
lengths=()
dirs=()
while [ $# -gt 0 ]; do
    if [ "$1" != --attributes ] || [ $# -lt 3 ]; then
        usage
    fi
    attributes+=("$2")
    starts+=("${#dirs[@]}")
    shift 2
    while [ $# -gt 0 ] && [ "$1" != --attributes ]; do
        dirs+=("$1")
        shift
    done
    lengths+=($((${#dirs[@]} - ${starts[-1]})))
    [ "${lengths[-1]}" -gt 0 ] || usage
done
[ ${#attributes[@]} -gt 0 ] || usage

pointer='version https://git-lfs.github.com/spec/'
count=0
status=0

for i in "${!attributes[@]}"; do
    file=${attributes[$i]}
    [ -f "$file" ] || die "$file: no such file"

    patterns=()
    while read -r pattern rest; do
        case " $rest " in
            *" filter=lfs "*) ;;
            *) continue ;;
        esac
        case $pattern in
            */*) die "$file: '$pattern' holds a slash, which this check does not read" ;;
        esac
        patterns+=("$pattern")
    done < "$file"

    [ ${#patterns[@]} -gt 0 ] || die "$file names no filter=lfs pattern"

    names=()
    for pattern in "${patterns[@]}"; do
        names+=(-o -name "$pattern")
    done

    folders=("${dirs[@]:${starts[$i]}:${lengths[$i]}}")
    # find's status is checked through wait, since a process substitution's own
    # failure, such as a missing folder, would otherwise pass unseen.
    mapfile -t -d '' found < <(find "${folders[@]}" -name .git -prune -o \
        -type f \( "${names[@]:1}" \) -print0)
    wait $! || die "find failed in ${folders[*]}"
    # A group that matches nothing is a mistaken pairing, never a clean pass.
    [ ${#found[@]} -gt 0 ] || die "$file: no file in ${folders[*]} matches its patterns"

    for f in "${found[@]}"; do
        count=$((count + 1))
        # Read in the shell rather than by a process per file; read fails at the
        # end of a file shorter than the pointer's prefix, which is no pointer.
        [ -r "$f" ] || die "$f: not readable"
        prefix=
        IFS= read -r -N "${#pointer}" prefix < "$f" || true
        if [ "$prefix" = "$pointer" ]; then
            echo "$f: an LFS pointer, not the file it stands for (git lfs pull)" >&2
            status=1
        fi
    done
done

echo "checked $count LFS file(s)" >&2

exit $status
