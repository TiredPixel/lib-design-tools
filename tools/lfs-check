#!/usr/bin/env bash
#
# Fail where a file that Git LFS should hold is still a pointer: a clone made
# without git-lfs, or a submodule whose objects were never pulled, leaves a
# small text file where a font or an image should be, and a browser fails on it
# quietly.
#
#   lfs-check --attributes FILE DIR...
#
# The patterns are the filter=lfs lines of FILE, read as basename globs, which
# is how every pattern holding no slash matches in .gitattributes.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

usage() {
    echo "usage: lfs-check --attributes FILE DIR..." >&2
    exit 2
}

die() {
    echo "lfs-check: $*" >&2
    exit 1
}

if [ $# -lt 3 ] || [ "$1" != --attributes ]; then
    usage
fi
attributes=$2
shift 2

[ -f "$attributes" ] || die "$attributes: no such file"

patterns=()
while read -r pattern rest; do
    case " $rest " in
        *" filter=lfs "*) ;;
        *) continue ;;
    esac
    case $pattern in
        */*) die "$attributes: '$pattern' holds a slash, which this check does not read" ;;
    esac
    patterns+=("$pattern")
done < "$attributes"

[ ${#patterns[@]} -gt 0 ] || die "$attributes names no filter=lfs pattern"

names=()
for pattern in "${patterns[@]}"; do
    names+=(-o -name "$pattern")
done

pointer='version https://git-lfs.github.com/spec/'
count=0
status=0

while IFS= read -r -d '' f; do
    count=$((count + 1))
    if cmp -s -n "${#pointer}" -- "$f" <(printf '%s' "$pointer"); then
        echo "$f: an LFS pointer, not the file it stands for (git lfs pull)" >&2
        status=1
    fi
done < <(find "$@" -name .git -prune -o -type f \( "${names[@]:1}" \) -print0)

echo "checked $count LFS file(s)" >&2

exit $status
