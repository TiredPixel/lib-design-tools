#!/usr/bin/env python3
"""Checks that the parts of each Word template given agree with each other.

Word refuses a package with a part it has no content type for or a relationship to a
part that is not there, and quietly drops a reference to a missing style, list or font,
so each such reference is checked against the part it names: every part has a content
type, and one that only the generic XML default types has an Override; each internal
relationship's target is a part; each relationship id a part uses is in its .rels; each
style, list and font a part names is defined in its scope, the glossary's own parts for
the glossary, the template's for the rest. ``--pandoc`` checks that the template
carries each style id pandoc's docx writer looks up. ``--fonts DIR`` checks that each
style's face, as Word resolves it for each script and table condition, is one a TrueType
file in DIR names.

Exit status: 0 when every template passes, 1 when any check fails, and 2 on a usage
error.
"""

import argparse
import io
import os
import pathlib
import posixpath
import struct
import sys
import xml.etree.ElementTree as ET
import zipfile

import design_ttf

CONTENT_TYPES = "[Content_Types].xml"
PACKAGE_RELS = "_rels/.rels"
RELS_TYPE = "application/vnd.openxmlformats-package.relationships+xml"
CT = "{http://schemas.openxmlformats.org/package/2006/content-types}"
PR = "{http://schemas.openxmlformats.org/package/2006/relationships}"
R = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}"
W = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}"

# A Default of plain XML types no WordprocessingML or package part, so each XML part it
# would cover needs an Override of its own.
GENERIC = "application/xml"

# Word resolves a part's styles, lists and fonts against the parts beside its own
# document: the glossary's against its own copies.
SCOPES = ("word/glossary/", "word/")

STYLE_REFERENCES = {
    "pStyle": "paragraph",
    "rStyle": "character",
    "tblStyle": "table",
    "styleLink": "numbering",
    "numStyleLink": "numbering",
}
LINKED = {"paragraph": "character", "character": "paragraph"}
FONT_SLOTS = ("ascii", "hAnsi", "cs", "eastAsia")
# Word sets basic Latin in the ascii font, accented Latin, Greek and Cyrillic in hAnsi,
# and complex scripts in cs, whose bold and italic are bCs and iCs.
SCRIPTS = (("ascii", "b", "i"), ("hAnsi", "b", "i"), ("cs", "bCs", "iCs"))

# The style ids pandoc's docx writer looks up.
PANDOC = {
    "Abstract": "paragraph",
    "AbstractTitle": "paragraph",
    "Author": "paragraph",
    "Bibliography": "paragraph",
    "BlockText": "paragraph",
    "BodyText": "paragraph",
    "CaptionedFigure": "paragraph",
    "Compact": "paragraph",
    "Date": "paragraph",
    "Definition": "paragraph",
    "DefinitionTerm": "paragraph",
    "Figure": "paragraph",
    "FirstParagraph": "paragraph",
    "FootnoteReference": "character",
    "FootnoteText": "paragraph",
    "Heading4": "paragraph",
    "Heading5": "paragraph",
    "Heading6": "paragraph",
    "ImageCaption": "paragraph",
    "ListParagraph": "paragraph",
    "SourceCode": "paragraph",
    "TOC1": "paragraph",
    "TOC2": "paragraph",
    "TOC3": "paragraph",
    "TOCHeading": "paragraph",
    "Table": "table",
    "TableCaption": "paragraph",
    "VerbatimChar": "character",
}


def val(element):
    return element.get(f"{W}val")


def style_type(style):
    """STYLE's type, ECMA-376 making a style without a w:type a paragraph style."""
    return style.get(f"{W}type", "paragraph")


def missing(element, attribute):
    """A problem where ELEMENT lacks ATTRIBUTE, else None.

    The check reading ATTRIBUTE reports this and passes over ELEMENT.
    """
    if element.get(attribute) is not None:
        return None
    return f"{element.tag.rpartition('}')[2]} has no {attribute.replace(W, 'w:')}"


def based_chain(style, by_id):
    """STYLE and each style its basedOn chain reaches, by BY_ID.

    The chain stops at a basedOn naming no style or one already reached, which
    style_problems reports, so a later check following it neither fails nor loops.
    """
    found = []
    while style is not None and style not in found:
        found.append(style)
        based = style.find(f"{W}basedOn")
        style = None if based is None else by_id.get(val(based))
    return found


class Unreadable(Exception):
    """A template that is no zip, or one with a part that is not XML."""


class Template:
    """A template's parts, each XML part parsed once, up front.

    A part that is not XML stops the template before any check runs, not partway
    through them.
    """

    def __init__(self, path):
        # Read whole, so only a regular file is: a device or a pipe may never end.
        if path.exists() and not path.is_file():
            raise Unreadable("not a regular file")
        try:
            data = path.read_bytes()
        except OSError as error:
            raise Unreadable(error.strerror or str(error)) from error
        try:
            with zipfile.ZipFile(io.BytesIO(data)) as archive:
                self.data = {name: archive.read(name) for name in archive.namelist()}
        # Whatever zipfile and its decompressors raise for an archive they cannot read,
        # which differs by damage and by Python release, is this template's one report.
        except Exception as error:
            raise Unreadable(f"not a zip: {str(error) or repr(error)}") from error
        self.parts = sorted(set(self.data) - {CONTENT_TYPES})
        self.roots = {}
        for name, data in self.data.items():
            if name.endswith((".xml", ".rels")):
                try:
                    self.roots[name] = ET.fromstring(data)
                except (ET.ParseError, LookupError) as error:
                    raise Unreadable(f"{name}: not XML: {error}") from error

    def root(self, path):
        return self.roots[path]

    def definitions(self, path):
        """The styles, numbering or font table part at PATH, or an empty one.

        A template with no lists, for one, has no numbering part.
        """
        return self.root(path) if path in self.data else ET.Element("none")

    def scoped(self, directory):
        """The XML parts whose references name DIRECTORY's styles, lists and fonts."""
        return [
            p
            for p in self.parts
            if p.endswith(".xml")
            and next((s for s in SCOPES if p.startswith(s)), None) == directory
        ]

    def scopes(self):
        """Each scope the template holds, the glossary only where it has one."""
        return [d for d in SCOPES if d + "document.xml" in self.data]

    def styles(self, directory):
        """Each style id in DIRECTORY's styles part, with its type."""
        return {
            s.get(f"{W}styleId"): style_type(s)
            for s in self.definitions(directory + "styles.xml").iter(f"{W}style")
        }


def content_type_problems(template):
    if CONTENT_TYPES not in template.data:
        yield CONTENT_TYPES, "is missing, so no part has a content type"
        return
    types = template.root(CONTENT_TYPES)
    defaults = {}
    for default in types.iter(f"{CT}Default"):
        if problem := missing(default, "Extension"):
            yield CONTENT_TYPES, problem
        else:
            defaults[default.get("Extension").lower()] = default.get("ContentType")
    overrides = set()
    for override in types.iter(f"{CT}Override"):
        if problem := missing(override, "PartName"):
            yield CONTENT_TYPES, problem
        elif not override.get("ContentType"):
            # Left out of the parts covered, so the part is reported as well.
            part = override.get("PartName")
            yield CONTENT_TYPES, f"Override for {part} has no ContentType"
        else:
            part = override.get("PartName").lstrip("/")
            overrides.add(part)
            if part not in template.parts:
                yield CONTENT_TYPES, f"Override names {part}, which is no part"
            elif part.endswith(".rels") and override.get("ContentType") != RELS_TYPE:
                yield CONTENT_TYPES, f"Override types {part} as no relationships part"
    for path in template.parts:
        _, dot, extension = posixpath.basename(path).rpartition(".")
        default = defaults.get(extension.lower()) if dot else None
        if path in overrides:
            continue
        if default is None:
            yield path, "has no content type"
        elif default == GENERIC:
            yield path, f"has no Override, only the {GENERIC} Default"


def relationship_problems(template):
    if PACKAGE_RELS not in template.data:
        yield PACKAGE_RELS, "is missing, so the package names no document"
    for rels in (p for p in template.parts if p.endswith(".rels")):
        source = posixpath.dirname(posixpath.dirname(rels))
        for rel in template.root(rels).iter(f"{PR}Relationship"):
            if problem := missing(rel, "Id") or missing(rel, "Target"):
                yield rels, problem
                continue
            if rel.get("TargetMode") == "External":
                continue
            target = rel.get("Target")
            resolved = (
                target.lstrip("/")
                if target.startswith("/")
                else posixpath.normpath(posixpath.join(source, target))
            )
            if resolved not in template.parts:
                yield rels, f"{rel.get('Id')} targets {target}, which is no part"
    for path in (p for p in template.parts if p.endswith(".xml")):
        named = {
            value
            for element in template.root(path).iter()
            for key, value in element.attrib.items()
            if key.startswith(R)
        }
        if not named:
            continue
        directory, name = posixpath.split(path)
        rels = posixpath.join(directory, "_rels", name + ".rels")
        ids = (
            {r.get("Id") for r in template.root(rels).iter(f"{PR}Relationship")}
            if rels in template.data
            else set()
        )
        for rid in sorted(named - ids):
            yield path, f"names {rid}, which {rels} does not hold"


def style_problems(template):
    def wrong(known, style_id, kind):
        if style_id is None:
            return "has no w:val"
        if known.get(style_id) != kind:
            return f"{style_id} is no {kind} style"
        return None

    for directory in template.scopes():
        known = template.styles(directory)
        for path in template.scoped(directory):
            root = template.root(path)
            for tag, kind in STYLE_REFERENCES.items():
                for ref in root.iter(f"{W}{tag}"):
                    if problem := wrong(known, val(ref), kind):
                        yield path, f"{tag}: {problem}"
            for part_pr in root.iter(f"{W}docPartPr"):
                for style in part_pr.iter(f"{W}style"):
                    if problem := wrong(known, val(style), "paragraph"):
                        yield path, f"docPart: {problem}"
        styles = directory + "styles.xml"
        definitions = template.definitions(styles)
        by_id = {s.get(f"{W}styleId"): s for s in definitions.iter(f"{W}style")}
        for style in definitions.iter(f"{W}style"):
            name = style.get(f"{W}styleId")
            own = style_type(style)
            expected = {"basedOn": own, "next": "paragraph", "link": LINKED.get(own)}
            for tag, target in expected.items():
                for ref in style.iter(f"{W}{tag}"):
                    if problem := wrong(known, val(ref), target):
                        yield styles, f"{name}: {tag}: {problem}"
            based = style.find(f"{W}basedOn")
            if based is not None and style in based_chain(by_id.get(val(based)), by_id):
                yield styles, f"{name}: basedOn: loops back to {name}"
            for conditional in style.iterfind(f"{W}tblStylePr"):
                if problem := missing(conditional, f"{W}type"):
                    yield styles, f"{name}: {problem}"


def pandoc_problems(template):
    known = template.styles("word/")
    for style_id, kind in PANDOC.items():
        if known.get(style_id) != kind:
            yield "word/styles.xml", f"no {kind} style {style_id}, which pandoc reads"


def numbering_problems(template):
    for directory in template.scopes():
        path = directory + "numbering.xml"
        numbering = template.definitions(path)
        nums = {n.get(f"{W}numId") for n in numbering.iter(f"{W}num")}
        abstracts = {
            a.get(f"{W}abstractNumId") for a in numbering.iter(f"{W}abstractNum")
        }
        for part in template.scoped(directory):
            for num_pr in template.root(part).iter(f"{W}numPr"):
                num_id = num_pr.find(f"{W}numId")
                if num_id is None:
                    continue
                if problem := missing(num_id, f"{W}val"):
                    yield part, problem
                elif val(num_id) not in nums | {"0"}:
                    yield part, f"numId {val(num_id)} is not defined"
        for abstract in numbering.iter(f"{W}abstractNum"):
            if problem := missing(abstract, f"{W}abstractNumId"):
                yield path, problem
        for num in numbering.iter(f"{W}num"):
            num_id = num.get(f"{W}numId")
            abstract = num.find(f"{W}abstractNumId")
            if problem := missing(num, f"{W}numId"):
                yield path, problem
            elif abstract is None:
                yield path, f"num {num_id}: has no abstractNumId"
            elif problem := missing(abstract, f"{W}val"):
                yield path, f"num {num_id}: {problem}"
            elif val(abstract) not in abstracts:
                yield path, f"num {num_id}: abstractNum {val(abstract)} is not defined"


def font_problems(template):
    for directory in template.scopes():
        table = template.definitions(directory + "fontTable.xml")
        declared = {f.get(f"{W}name") for f in table.iter(f"{W}font")}
        for path in template.scoped(directory):
            named = {
                r.get(f"{W}{slot}")
                for r in template.root(path).iter(f"{W}rFonts")
                for slot in FONT_SLOTS
                if r.get(f"{W}{slot}")
            }
            for font in sorted(named - declared):
                yield path, f"names font {font}, which fontTable.xml does not declare"


def shipped_faces(directory):
    """Every (family, bold, italic) the TrueType files in DIRECTORY give Word."""
    # A glob of a directory that cannot be listed finds no file, which would report
    # every face as not shipped, so the directory is listed first for the reason.
    try:
        os.listdir(directory)
    except OSError as error:
        raise Unreadable(f"{directory}: {error.strerror or error}") from error
    found = set()
    for path in sorted(directory.glob("*.ttf")):
        if not path.is_file():
            raise Unreadable(f"{path}: not a regular file")
        try:
            names = design_ttf.names(path.read_bytes())
        except (OSError, KeyError, struct.error, UnicodeDecodeError) as error:
            raise Unreadable(f"{path}: not a TrueType font: {error!r}") from error
        if not {design_ttf.FAMILY, design_ttf.SUBFAMILY} <= names.keys():
            raise Unreadable(f"{path}: names no family and subfamily Word reads")
        subfamily = names[design_ttf.SUBFAMILY]
        found.add(
            (names[design_ttf.FAMILY], "Bold" in subfamily, "Italic" in subfamily)
        )
    return found


def face_problems(template, faces):
    root = template.definitions("word/styles.xml")
    defaults = root.find(f"{W}docDefaults/{W}rPrDefault/{W}rPr")
    by_id = {s.get(W + "styleId"): s for s in root.iter(W + "style")}

    def chain(style):
        return based_chain(style, by_id)

    # A table style's conditional formatting, such as its first row's, from wherever
    # along the basedOn chain sets it, then the style's own. Given an attribute, only
    # an element carrying it counts, as each of rFonts' attributes is inherited on its
    # own.
    def setting(style, tag, condition, attribute=None):
        ancestors = chain(style)
        run_properties = [
            conditional.find(W + "rPr")
            for ancestor in ancestors
            for conditional in ancestor.iterfind(W + "tblStylePr")
            if condition is not None and conditional.get(W + "type") == condition
        ]
        run_properties += [ancestor.find(W + "rPr") for ancestor in ancestors]
        for properties in run_properties:
            found = None if properties is None else properties.find(W + tag)
            if found is not None and (
                attribute is None or found.get(W + attribute) is not None
            ):
                return found
        return None if defaults is None else defaults.find(W + tag)

    def on(element):
        # Each value ST_OnOff reads as off; with no value, the element turns it on.
        return element is not None and val(element) not in ("0", "false", "off")

    for style_id, style in by_id.items():
        # A tblStylePr without a type, which style_problems reports, sets no condition.
        conditions = {
            c.get(W + "type")
            for ancestor in chain(style)
            for c in ancestor.iterfind(W + "tblStylePr")
        } - {None}
        for condition in (None, *sorted(conditions)):
            for attribute, bold, italic in SCRIPTS:
                fonts = setting(style, "rFonts", condition, attribute)
                face = (
                    None if fonts is None else fonts.get(W + attribute),
                    on(setting(style, bold, condition)),
                    on(setting(style, italic, condition)),
                )
                if face not in faces:
                    where = style_id if condition is None else f"{style_id} {condition}"
                    yield (
                        "word/styles.xml",
                        f"{where}: {attribute} face {face} is not shipped",
                    )


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="ooxml-check", description=__doc__.split("\n\n")[0]
    )
    parser.add_argument("--fonts", type=pathlib.Path, metavar="DIR")
    parser.add_argument("--pandoc", action="store_true")
    parser.add_argument("templates", nargs="+", type=pathlib.Path, metavar="TEMPLATE")
    arguments = parser.parse_args(argv)
    failures = 0
    try:
        faces = None if arguments.fonts is None else shipped_faces(arguments.fonts)
    except Unreadable as error:
        # Reported, and the faces left unchecked rather than checked against a set
        # missing this font's.
        print(f"ooxml-check: {error}", file=sys.stderr)
        failures += 1
        faces = None
    for path in arguments.templates:
        try:
            template = Template(path)
        except Unreadable as error:
            print(f"ooxml-check: {path}: {error}", file=sys.stderr)
            failures += 1
            continue
        checks = [
            content_type_problems,
            relationship_problems,
            style_problems,
            numbering_problems,
            font_problems,
        ]
        if arguments.pandoc:
            checks.append(pandoc_problems)
        for check in checks:
            for part, message in check(template):
                print(f"{path}: {part}: {message}", file=sys.stderr)
                failures += 1
        if faces is not None:
            for part, message in face_problems(template, faces):
                print(f"{path}: {part}: {message}", file=sys.stderr)
                failures += 1
    print(
        f"ooxml-check: checked {len(arguments.templates)} template(s): "
        f"{failures} problem(s)",
        file=sys.stderr,
    )
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
