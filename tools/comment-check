class _Shell:
    """A bash lexer: comments everywhere, and the top level's words and operators."""

    def __init__(self, source: str) -> None:
        self.source = source
        self.comments: list[Text] = []
        self.tokens: list[_Word | _Operator] = []
        self.pending: list[_Heredoc] = []

    def _operator(self, operator: _Operator, nested: bool) -> None:
        if not nested:
            self.tokens.append(operator)

    def commands(self, start: int, nested: bool) -> int:
        """Lex commands from ``start``; nested, return past the ``)`` that ends them."""
        source = self.source
        i = start
        begin: int | None = None
        literals: list[tuple[int, int]] = []
        depth = 0

        def literal(first: int, end: int) -> None:
            nonlocal begin
            if begin is None:
                begin = first
            if literals and literals[-1][1] == first:
                literals[-1] = (literals[-1][0], end)
            elif end > first:
                literals.append((first, end))

        def end_word() -> None:
            nonlocal begin, literals
            if begin is not None:
                text = source[begin:i]
                if nested and text == "case":
                    raise LexError(begin, "case inside $(...), which this does not lex")
                if not nested:
                    self.tokens.append(_Word(text, literals))
            begin, literals = None, []

        while i < len(source):
            char = source[i]
            if char == "\n":
                end_word()
                self._operator(_Operator("\n"), nested)
                i = self._heredoc_bodies(i + 1)
            elif char in " \t":
                end_word()
                i += 1
            elif char == "#" and begin is None:
                end = source.find("\n", i)
                end = len(source) if end == -1 else end
                self.comments.append(Text(i, end, True))
                i = end
            elif char == "\\" and source.startswith("\n", i + 1):
                i += 2
            elif char == "\\":
                literal(i, i)
                literal(i + 1, i + 2)
                i += 2
            elif char == "'":
                close = source.find("'", i + 1)
                if close == -1:
                    raise LexError(i, "single quote never closed")
                literal(i, i)
                literal(i + 1, close)
                i = close + 1
            elif char in '"`$' or (char in "<>" and source.startswith("(", i + 1)):
                literal(i, i)
                spans = None if nested else literals
                if char == '"':
                    i = self._double(i + 1, spans)
                elif char == "`":
                    i = self._backtick(i + 1)
                elif char == "$":
                    i = self._dollar(i, spans, False)
                else:
                    i = self.commands(i + 2, True)
            elif char == "(" and begin is None and source.startswith("((", i):
                i = self._arithmetic(i, i + 2)
            elif char == "(":
                end_word()
                self._operator(_Operator("("), nested)
                depth += 1
                i += 1
            elif char == ")":
                end_word()
                if nested and depth == 0:
                    return i + 1
                self._operator(_Operator(")"), nested)
                depth -= 1
                i += 1
            elif source.startswith("<<", i) and not source.startswith("<<<", i):
                end_word()
                i = self._heredoc(i, nested)
            elif char in ";&|<>":
                end_word()
                operator = next(
                    op for op in _SHELL_OPERATORS if source.startswith(op, i)
                )
                self._operator(_Operator(operator), nested)
                i += len(operator)
            else:
                literal(i, i + 1)
                i += 1
        end_word()
        if nested:
            raise LexError(start - 2, "command substitution never closed")
        if self.pending:
            raise LexError(self.pending[0].offset, "here-document never ends")
        return i

    def _double(self, i: int, literals: list[tuple[int, int]] | None) -> int:
        source = self.source
        start = i - 1
        segment = i
        while i < len(source):
            char = source[i]
            if char in '"$`' and literals is not None and i > segment:
                literals.append((segment, i))
            if char == '"':
                return i + 1
            if char == "\\":
                i += 2
                continue
            if char == "$":
                i = self._dollar(i, None, True)
            elif char == "`":
                i = self._backtick(i + 1)
            else:
                i += 1
                continue
            segment = i
        raise LexError(start, "double quote never closed")

    def _backtick(self, i: int) -> int:
        source = self.source
        start = i - 1
        while i < len(source):
            if source[i] == "\\":
                i += 2
            elif source[i] == "`":
                return i + 1
            else:
                i += 1
        raise LexError(start, "backtick never closed")

    def _dollar(
        self, i: int, literals: list[tuple[int, int]] | None, quoted: bool
    ) -> int:
        source = self.source
        if source.startswith("$((", i):
            return self._arithmetic(i, i + 3)
        if source.startswith("$(", i):
            return self.commands(i + 2, True)
        if source.startswith("${", i):
            return self._parameter(i + 2, quoted)
        if source.startswith("$'", i) and not quoted:
            return self._ansi(i + 2, literals)
        if source.startswith('$"', i) and not quoted:
            return self._double(i + 2, literals)
        if source[i + 1 : i + 2] in _SHELL_SPECIAL_PARAMETERS:
            return i + 2
        return i + 1

    def _ansi(self, i: int, literals: list[tuple[int, int]] | None) -> int:
        source = self.source
        start = i
        while i < len(source):
            if source[i] == "\\":
                i += 2
            elif source[i] == "'":
                if literals is not None:
                    literals.append((start, i))
                return i + 1
            else:
                i += 1
        raise LexError(start - 2, "$' never closed")

    def _parameter(self, i: int, quoted: bool) -> int:
        source = self.source
        start = i - 2
        while i < len(source):
            char = source[i]
            if char == "}":
                return i + 1
            if char == "\\":
                i += 2
            elif char == "'" and quoted:
                raise LexError(
                    i,
                    "single quote inside a double-quoted ${...}, which this does not lex",
                )
            elif char == "'":
                close = source.find("'", i + 1)
                if close == -1:
                    raise LexError(i, "single quote never closed")
                i = close + 1
            elif char == '"':
                i = self._double(i + 1, None)
            elif char == "`":
                i = self._backtick(i + 1)
            elif char == "$":
                i = self._dollar(i, None, quoted)
            elif char == "{":
                raise LexError(i, "brace inside ${...}, which this does not lex")
            else:
                i += 1
        raise LexError(start, "${ never closed")

    def _arithmetic(self, start: int, i: int) -> int:
        source = self.source
        depth = 0
        while i < len(source):
            char = source[i]
            if char == "(":
                depth += 1
                i += 1
            elif char == ")" and depth:
                depth -= 1
                i += 1
            elif char == ")" and source.startswith("))", i):
                return i + 2
            elif char == ")":
                raise LexError(
                    i, "(( closed by a single ')', a subshell this does not lex"
                )
            elif char == "\\":
                i += 2
            elif char == '"':
                i = self._double(i + 1, None)
            elif char == "`":
                i = self._backtick(i + 1)
            elif char == "$":
                i = self._dollar(i, None, False)
            else:
                i += 1
        raise LexError(start, "(( never closed")

    def _heredoc(self, i: int, nested: bool) -> int:
        source = self.source
        start = i
        i += 2
        strip_tabs = source.startswith("-", i)
        if strip_tabs:
            i += 1
        while i < len(source) and source[i] in " \t":
            i += 1
        delimiter = []
        while i < len(source) and source[i] not in _SHELL_WORD_END:
            char = source[i]
            if char in "'\"":
                close = source.find(char, i + 1)
                if close == -1:
                    raise LexError(i, "quote in a here-document delimiter never closed")
                delimiter.append(source[i + 1 : close])
                i = close + 1
            elif char == "\\":
                delimiter.append(source[i + 1 : i + 2])
                i += 2
            else:
                delimiter.append(char)
                i += 1
        if not delimiter:
            raise LexError(start, "here-document with no delimiter")
        operator = _Operator("<<")
        self.pending.append(_Heredoc("".join(delimiter), strip_tabs, operator, start))
        self._operator(operator, nested)
        return i

    def _heredoc_bodies(self, i: int) -> int:
        source = self.source
        for heredoc in self.pending:
            body = i
            while True:
                if i >= len(source):
                    raise LexError(
                        heredoc.offset,
                        f"here-document never ends: no line {heredoc.delimiter!r}",
                    )
                end = source.find("\n", i)
                end = len(source) if end == -1 else end
                line = source[i:end]
                if heredoc.strip_tabs:
                    line = line.lstrip("\t")
                if line == heredoc.delimiter:
                    heredoc.operator.body = (body, i)
                    i = end + 1
                    break
                i = end + 1
        self.pending.clear()
        return min(i, len(source))


def _usage_texts(tokens: list[_Word | _Operator]) -> list[Text]:
    """Return the usage text in the top-level tokens of a shell script.

    That is the arguments of echo and printf, and the bodies of here-documents, inside
    the braces of a function named usage.
    """
    texts = []
    depth = 0
    header = False
    command: str | None = None
    arguments = 0
    redirect = False
    for index, token in enumerate(tokens):
        if isinstance(token, _Operator):
            if token.text == "<<":
                if depth:
                    texts.append(Text(*token.body, False))
            elif token.text in _SHELL_REDIRECTIONS:
                redirect = True
            else:
                command = None
            continue
        if redirect:
            redirect = False
            continue
        word = token.text
        # A function body in parentheses is a subshell, never read as usage text.
        if header:
            header = False
            if word == "{":
                depth, command = 1, None
                continue
        if command is None:
            if word == "{" and depth:
                depth += 1
            elif word == "}" and depth:
                depth -= 1
            elif word not in _SHELL_RESERVED:
                command, arguments = word, 0
                following = tokens[index + 1 : index + 2]
                if word == "usage" and following and following[0].text == "(":
                    header = True
        else:
            arguments += 1
            if command == "function" and arguments == 1 and word == "usage":
                header = True
            elif depth and command in ("echo", "printf"):
                texts.extend(Text(start, end, False) for start, end in token.literals)
    return texts


def shell_texts(source: str) -> list[Text]:
    """Return the comments and usage text in bash source."""
    shell = _Shell(source)
    shell.commands(0, False)
    return shell.comments + _usage_texts(shell.tokens)


LEXERS = {
    "css": css_texts,
    "javascript": javascript_texts,
    "python": python_texts,
    "shell": shell_texts,
    "yaml": yaml_texts,
}


def language(path: pathlib.Path) -> str | None:
    """Return the language of ``path`` by suffix, else shebang or directive."""
    if path.suffix.lower() in SUFFIXES:
        return SUFFIXES[path.suffix.lower()]
    with path.open("rb") as stream:
        first = stream.readline().decode("utf-8", "replace").strip()
    if first.startswith("#!"):
        words = first[2:].split()
        if words and pathlib.PurePath(words[0]).name == "env":
            words = [word for word in words[1:] if not word.startswith("-")]
        if not words:
            return None
        interpreter = pathlib.PurePath(words[0]).name
        if _PYTHON.fullmatch(interpreter):
            return "python"
        return INTERPRETERS.get(interpreter)
    if _SHELLCHECK_DIRECTIVE.match(first):
        return "shell"
    return None


def check(source: str, kind: str) -> list[tuple[int, int, str]]:
    """Return ``(line, column, message)`` for each violation in ``source``.

    Raises LexError where the lexer for ``kind`` cannot read the source.
    """
    offsets = set()
    for text in LEXERS[kind](source):
        segment = source[text.start : text.end]
        exempt = code_spans(segment) if text.spans else []
        for match in _FORBIDDEN.finditer(segment):
            index = match.start()
            if not any(start <= index < end for start, end in exempt):
                offsets.add(text.start + index)
    problems = []
    for offset in sorted(offsets):
        line, column = position(source, offset)
        char = source[offset]
        name = unicodedata.name(char)
        message = (
            f"{char} (U+{ord(char):04X} {name}); write {typewriter(source, offset)}"
        )
        problems.append((line, column, message))
    return problems


def position(source: str, offset: int) -> tuple[int, int]:
    """Return the 1-based line and column of ``offset``."""
    line = source.count("\n", 0, offset) + 1
    return line, offset - source.rfind("\n", 0, offset)


def parse_arguments(argv: list[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="comment-check",
        description=(
            "Fail on typographic punctuation in comments, docstrings and usage text."
        ),
    )
    parser.add_argument("files", nargs="+", type=pathlib.Path, metavar="FILE")
    arguments = parser.parse_args(argv)
    for path in arguments.files:
        if not path.is_file():
            parser.error(f"{path} is not a file")
        if language(path) is None:
            parser.error(f"cannot tell the language of {path}")
    return arguments


def main(argv: list[str] | None = None) -> int:
    arguments = parse_arguments(argv)
    problems = 0
    unreadable = 0
    for path in arguments.files:
        try:
            source = path.read_text(encoding="utf-8")
        except UnicodeDecodeError as error:
            print(f"{path}: not valid UTF-8: {error}", file=sys.stderr)
            unreadable += 1
            continue
        try:
            found = check(source, language(path))
        except LexError as error:
            line, _ = position(source, error.offset)
            print(f"{path}:{line}: cannot lex: {error.message}", file=sys.stderr)
            unreadable += 1
            continue
        for line, column, message in found:
            print(f"{path}:{line}:{column}: {message}", file=sys.stderr)
            problems += 1
    print(
        f"checked {len(arguments.files)} file(s): {problems} problem(s)",
        file=sys.stderr,
    )
    if unreadable:
        return 2
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
