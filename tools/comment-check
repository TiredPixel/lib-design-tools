#!/usr/bin/env python3
"""Fail on typographic punctuation in comments, docstrings and usage text.

Code text is written in typewriter punctuation, since it is grepped, diffed and pasted
into terminals. Each of these characters is reported with the typewriter form that
replaces it: U+2013 EN DASH (``-`` closed up in a range, ``--`` otherwise), U+2014 EM
DASH (``--``), U+2026 HORIZONTAL ELLIPSIS (``...``), U+2018 and U+2019 single quotation
marks (``'``), U+201C and U+201D double quotation marks (``"``), the arrows U+2190 to
U+21FF (``<-``, ``<->`` or ``->`` by direction), and U+2264 and U+2265 (``<=`` and
``>=``). Every other character passes, so letters keep their diacritics and their
scripts.

Languages. A file's language comes from its suffix: ``.py``; ``.css``; ``.js``, ``.mjs``
and ``.cjs``; ``.yml`` and ``.yaml``; ``.sh`` and ``.bash``. A file with no such suffix
is known by its shebang, naming ``python``, ``python3``, ``python3.N``, ``bash``, ``sh``
or ``node`` directly or through ``env``, or by a first line holding ShellCheck's
``shell=bash`` or ``shell=sh`` directive, which is how a sourced shell file names its
dialect.

What is read. Comments, found by lexing and never by searching lines: Python's through
tokenize; CSS ``/* */`` outside strings and unquoted ``url()``; JavaScript ``//`` and
``/* */`` outside strings, template literals and regular-expression literals; YAML ``#``
outside quoted and block scalars; and shell ``#`` at the start of a word, outside
quotes, here-document bodies, ``${...}``, ``$((...))`` and backticks. The commands in a
shell ``$(...)`` or ``<(...)`` are lexed in turn, so a comment there is read too. Python
docstrings, of modules, classes and functions. Usage text: the strings given to the
``description``, ``epilog``, ``help``, ``title`` and ``usage`` keywords of argparse's
parser and argument calls, and inside the braces of a shell function named ``usage`` the
arguments of ``echo`` and ``printf`` and the bodies of here-documents.

Reproduced text is exempt: inside a code span in a comment or docstring, a run of
backticks closed by a run of the same length, any character may be quoted. Usage text
has no code spans, since nothing renders it.

Where a lexer cannot tell with certainty what it is reading, it stops and names the file
and line rather than guess: a ``/`` after ``}``, ``++`` or ``--`` in JavaScript, which
may divide or open a regular expression; ``case`` inside a shell ``$(...)``, whose
patterns close parentheses they never opened; a ``$((`` closed by a single ``)``; a
single quote inside a double-quoted ``${...}``, or a brace inside any; a YAML block
scalar header with an explicit indentation indicator, or with no key or sequence entry
on its line to give the indent its content must pass; and anything left open or found
invalid.

Each violation is printed to standard error as ``FILE:LINE:COLUMN:`` and the character,
its name and its typewriter form, followed by a count of the files checked.

Exit status: 0 when every file is clean, 1 when any holds a violation, 2 on a usage
error or a file that is not UTF-8 or cannot be lexed.
"""

from __future__ import annotations

import argparse
import ast
import dataclasses
import io
import pathlib
import re
import sys
import tokenize
import unicodedata

SUFFIXES = {
    ".bash": "shell",
    ".cjs": "javascript",
    ".css": "css",
    ".js": "javascript",
    ".mjs": "javascript",
    ".py": "python",
    ".sh": "shell",
    ".yaml": "yaml",
    ".yml": "yaml",
}

INTERPRETERS = {
    "bash": "shell",
    "node": "javascript",
    "sh": "shell",
}

TYPEWRITER = {
    "\u2014": "--",
    "\u2018": "'",
    "\u2019": "'",
    "\u201c": '"',
    "\u201d": '"',
    "\u2026": "...",
    "\u2264": "<=",
    "\u2265": ">=",
}

EN_DASH = "\u2013"

_FORBIDDEN = re.compile(
    "[\u2013\u2014\u2018\u2019\u201c\u201d\u2026\u2190-\u21ff\u2264\u2265]"
)
_PYTHON = re.compile(r"python(?:3(?:\.\d+)?)?")
_SHELLCHECK_DIRECTIVE = re.compile(r"#\s*shellcheck\s.*\bshell=(?:bash|sh)\b")
_BACKTICKS = re.compile(r"`+")

USAGE_CALLS = frozenset(
    {
        "ArgumentParser",
        "add_argument",
        "add_argument_group",
        "add_parser",
        "add_subparsers",
    }
)
USAGE_KEYWORDS = frozenset({"description", "epilog", "help", "title", "usage"})


class LexError(Exception):
    """Raised where a lexer cannot tell with certainty what it is reading."""

    def __init__(self, offset: int, message: str) -> None:
        super().__init__(message)
        self.offset = offset
        self.message = message


@dataclasses.dataclass(frozen=True)
class Text:
    """A stretch of source to check, by offset, and whether code spans are exempt."""

    start: int
    end: int
    spans: bool


def typewriter(source: str, offset: int) -> str:
    """Return the typewriter form of the forbidden character at ``offset``."""
    char = source[offset]
    if char == EN_DASH:
        before = source[offset - 1] if offset else " "
        after = source[offset + 1] if offset + 1 < len(source) else " "
        return "--" if before.isspace() or after.isspace() else "-"
    if char in TYPEWRITER:
        return TYPEWRITER[char]
    name = unicodedata.name(char)
    if "LEFT RIGHT" in name or ("LEFTWARDS" in name and "RIGHTWARDS" in name):
        return "<->"
    if "LEFTWARDS" in name:
        return "<-"
    return "->"


def code_spans(text: str) -> list[tuple[int, int]]:
    """Return ``(start, end)`` for each code span in ``text``.

    A backtick run opens a span only when a run of the same length closes it; an
    unmatched run, or one after a backslash, is literal text, as in CommonMark.
    """
    spans = []
    position = 0
    while (opening := _BACKTICKS.search(text, position)) is not None:
        start = opening.start()
        position = opening.end()
        if start > 0 and text[start - 1] == "\\":
            continue
        run = opening.group(0)
        closing = re.compile(rf"(?<!`){run}(?!`)").search(text, opening.end())
        if closing is not None:
            spans.append((start, closing.end()))
            position = closing.end()
    return spans


def _line_starts(source: str) -> list[int]:
    starts = [0]
    starts.extend(match.end() for match in re.finditer("\n", source))
    return starts


def _string(source: str, start: int) -> int:
    """Return the end of the CSS or JavaScript string opening at ``start``."""
    quote = source[start]
    i = start + 1
    while i < len(source):
        char = source[i]
        if char == "\\":
            i += 3 if source.startswith("\r\n", i + 1) else 2
        elif char == quote:
            return i + 1
        elif char in "\n\r":
            break
        else:
            i += 1
    raise LexError(start, "string never closed on its line")


def _block_comment(source: str, start: int) -> int:
    end = source.find("*/", start + 2)
    if end == -1:
        raise LexError(start, "comment never closed")
    return end + 2


_DOCUMENTED = (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)


def _call_name(function: ast.expr) -> str | None:
    if isinstance(function, ast.Attribute):
        return function.attr
    if isinstance(function, ast.Name):
        return function.id
    return None


def python_texts(source: str) -> list[Text]:
    """Return the comments, docstrings and argparse usage text in Python source."""
    starts = _line_starts(source)
    lines = source.split("\n")

    # ast counts columns in UTF-8 bytes, tokenize in characters.
    def offset(node: ast.expr, end: bool) -> int:
        line = node.end_lineno if end else node.lineno
        column = node.end_col_offset if end else node.col_offset
        prefix = lines[line - 1].encode()[:column].decode()
        return starts[line - 1] + len(prefix)

    try:
        tree = ast.parse(source)
    except SyntaxError as error:
        line = min(error.lineno or 1, len(starts))
        raise LexError(starts[line - 1], f"not valid Python: {error.msg}") from error

    texts = []
    for token in tokenize.generate_tokens(io.StringIO(source).readline):
        if token.type == tokenize.COMMENT:
            (line, column), (end_line, end_column) = token.start, token.end
            texts.append(
                Text(starts[line - 1] + column, starts[end_line - 1] + end_column, True)
            )

    for node in ast.walk(tree):
        if isinstance(node, _DOCUMENTED) and node.body:
            first = node.body[0]
            if (
                isinstance(first, ast.Expr)
                and isinstance(first.value, ast.Constant)
                and isinstance(first.value.value, str)
            ):
                texts.append(
                    Text(offset(first.value, False), offset(first.value, True), True)
                )
        elif isinstance(node, ast.Call) and _call_name(node.func) in USAGE_CALLS:
            for keyword in node.keywords:
                if keyword.arg not in USAGE_KEYWORDS:
                    continue
                for part in ast.walk(keyword.value):
                    if isinstance(part, ast.JoinedStr) or (
                        isinstance(part, ast.Constant) and isinstance(part.value, str)
                    ):
                        texts.append(
                            Text(offset(part, False), offset(part, True), False)
                        )
    return texts


_CSS_URL = re.compile(r"(?<![\w-])url\(\s*", re.IGNORECASE)


def _css_url(source: str, start: int, i: int) -> int:
    while i < len(source):
        char = source[i]
        if char == ")":
            return i + 1
        if char == "\\":
            i += 2
        elif char in "'\"(":
            raise LexError(i, "unquoted url() holds a quote or parenthesis")
        else:
            i += 1
    raise LexError(start, "url( never closed")


def css_texts(source: str) -> list[Text]:
    """Return the comments in CSS source."""
    texts = []
    i = 0
    while i < len(source):
        char = source[i]
        if source.startswith("/*", i):
            end = _block_comment(source, i)
            texts.append(Text(i, end, True))
            i = end
        elif char in "'\"":
            i = _string(source, i)
        elif char == "\\":
            i += 2
        elif (url := _CSS_URL.match(source, i)) is not None and not source.startswith(
            ("'", '"'), url.end()
        ):
            i = _css_url(source, i, url.end())
        else:
            i += 1
    return texts


_JS_WORD = re.compile(r"[\w$\\]+")
_JS_FLAGS = re.compile(r"[\w$]*")
_JS_LINE_END = re.compile("[\n\r\u2028\u2029]")

# Words after which a '/' opens a regular expression rather than dividing.
_JS_BEFORE_EXPRESSION = frozenset(
    {
        "await",
        "case",
        "delete",
        "do",
        "else",
        "in",
        "instanceof",
        "new",
        "of",
        "return",
        "throw",
        "typeof",
        "void",
        "yield",
    }
)

# Statements whose parenthesised head a '/' may follow as a regular expression.
_JS_CONTROL = frozenset({"for", "if", "while", "with"})


def _line_end(source: str, start: int) -> int:
    match = _JS_LINE_END.search(source, start)
    return match.start() if match else len(source)


def _js_regex(source: str, start: int) -> int:
    i = start + 1
    in_class = False
    while i < len(source) and not _JS_LINE_END.match(source, i):
        char = source[i]
        if char == "\\":
            i += 2
            continue
        if char == "[":
            in_class = True
        elif char == "]":
            in_class = False
        elif char == "/" and not in_class:
            return _JS_FLAGS.match(source, i + 1).end()
        i += 1
    raise LexError(start, "regular expression never closed on its line")


def _js_template(
    source: str, start: int, braces: list[tuple[int, bool]]
) -> tuple[int, str]:
    """Read template text from ``start``, to its end or to a substitution."""
    i = start
    while i < len(source):
        if source[i] == "\\":
            i += 2
        elif source[i] == "`":
            return i + 1, "divide"
        elif source.startswith("${", i):
            braces.append((i, True))
            return i + 2, "regex"
        else:
            i += 1
    raise LexError(start - 1, "template literal never closed")


def javascript_texts(source: str) -> list[Text]:
    """Return the comments in JavaScript source."""
    texts = []
    i = 0
    if source.startswith("#!"):
        i = _line_end(source, 0)
        texts.append(Text(0, i, True))
    # What a lone '/' starts here: "regex", "divide", or "unsure" where either could.
    slash = "regex"
    parens: list[tuple[int, bool]] = []
    braces: list[tuple[int, bool]] = []
    word: str | None = None
    member = False
    while i < len(source):
        char = source[i]
        if char.isspace() or char == "\ufeff":
            i += 1
            continue
        if source.startswith("//", i):
            end = _line_end(source, i)
            texts.append(Text(i, end, True))
            i = end
            continue
        if source.startswith("/*", i):
            end = _block_comment(source, i)
            texts.append(Text(i, end, True))
            i = end
            continue
        previous_word, previous_member = word, member
        word, member = None, False
        if char == "/":
            if slash == "unsure":
                raise LexError(
                    i,
                    "'/' after '}', '++' or '--' may divide or open a regular expression",
                )
            if slash == "regex":
                i = _js_regex(source, i)
                slash = "divide"
            else:
                i += 1
                slash = "regex"
        elif char in "'\"":
            i = _string(source, i)
            slash = "divide"
        elif char == "`":
            i, slash = _js_template(source, i + 1, braces)
        elif char == "}":
            if not braces:
                raise LexError(i, "'}' closes nothing")
            if braces.pop()[1]:
                i, slash = _js_template(source, i + 1, braces)
            else:
                i += 1
                slash = "unsure"
        elif char == "{":
            braces.append((i, False))
            i += 1
            slash = "regex"
        elif char == "(":
            parens.append((i, previous_word in _JS_CONTROL))
            i += 1
            slash = "regex"
        elif char == ")":
            if not parens:
                raise LexError(i, "')' closes nothing")
            slash = "regex" if parens.pop()[1] else "divide"
            i += 1
        elif char == "]":
            i += 1
            slash = "divide"
        elif (match := _JS_WORD.match(source, i)) is not None:
            word = None if previous_member else match.group()
            slash = "regex" if word in _JS_BEFORE_EXPRESSION else "divide"
            i = match.end()
        elif source.startswith(("++", "--"), i):
            i += 2
            slash = "unsure"
        elif source.startswith("...", i):
            i += 3
            slash = "regex"
        elif char == "." or (
            source.startswith("?.", i) and not source[i + 2 : i + 3].isdigit()
        ):
            member = True
            i += 1 if char == "." else 2
            slash = "regex"
        else:
            i += 1
            slash = "regex"
    if braces:
        raise LexError(braces[-1][0], "'{' or '${' never closed")
    if parens:
        raise LexError(parens[-1][0], "'(' never closed")
    return texts


_YAML_BLOCK_HEADER = re.compile(r"[|>]([-+0-9]*)(?=[ \t]|$)")
_YAML_DIRECTIVE_COMMENT = re.compile(r"[ \t]#")
_YAML_DOCUMENT = re.compile(r"(?:---|\.\.\.)(?=[ \t]|$)")


def _yaml_closing(line: str, i: int, quote: str) -> int | None:
    """Return the end of the quoted scalar continuing at ``i``, or None at line end."""
    while i < len(line):
        char = line[i]
        if (quote == '"' and char == "\\") or (
            char == quote == "'" and line.startswith("'", i + 1)
        ):
            i += 2
        elif char == quote:
            return i + 1
        else:
            i += 1
    return None


def _yaml_plain_end(line: str, i: int, flow: bool) -> int:
    while i < len(line):
        char = line[i]
        if char == "#" and line[i - 1] in " \t":
            break
        if char == ":" and (
            i + 1 == len(line)
            or line[i + 1] in " \t"
            or (flow and line[i + 1] in ",[]{}")
        ):
            break
        if flow and char in ",[]{}":
            break
        i += 1
    return i


class _Yaml:
    """A line-by-line YAML lexer, keeping what spans lines between them."""

    def __init__(self, source: str) -> None:
        self.source = source
        self.texts: list[Text] = []
        self.flow = 0
        self.flow_start = 0
        self.quote: str | None = None
        self.quote_start = 0
        # The parent indent of an open block scalar, and its content indent once known.
        self.block: tuple[int, int | None] | None = None
        # The parent indent of a plain scalar that may continue onto the next line.
        self.plain: int | None = None
        # Carried across lines only inside a flow collection.
        self.expect = True
        self.last_plain = False

    def lex(self) -> list[Text]:
        offset = 0
        for line in self.source.split("\n"):
            self._line(line.removesuffix("\r"), offset)
            offset += len(line) + 1
        if self.quote is not None:
            raise LexError(self.quote_start, "quoted scalar never closed")
        if self.flow:
            raise LexError(self.flow_start, "flow collection never closed")
        return self.texts

    def _in_block(self, line: str, indent: int) -> bool:
        parent, content = self.block
        if not line.strip():
            return True
        if content is None and indent > parent:
            self.block = (parent, indent)
            return True
        if content is not None and indent >= content:
            return True
        self.block = None
        return False

    def _line(self, line: str, offset: int) -> None:
        indent = len(line) - len(line.lstrip(" "))
        if self.block is not None and self._in_block(line, indent):
            return
        stripped = line.strip()
        if not stripped:
            return
        flow = self.flow > 0
        expect = self.expect if flow else True
        last_plain = self.last_plain if flow else False
        i = 0
        continuation = False
        if self.quote is not None:
            end = _yaml_closing(line, 0, self.quote)
            if end is None:
                return
            self.quote = None
            i, expect, last_plain = end, False, False
        elif (
            self.plain is not None
            and indent > self.plain
            and not stripped.startswith("#")
        ):
            i = _yaml_plain_end(line, indent, False)
            continuation, expect, last_plain = True, False, True
        elif not flow and line.startswith("%"):
            directive = _YAML_DIRECTIVE_COMMENT.search(line)
            if directive is not None:
                start = offset + directive.end() - 1
                self.texts.append(Text(start, offset + len(line), True))
            return
        elif not flow and _YAML_DOCUMENT.match(line):
            i, expect = 3, line.startswith("---")

        key: int | None = None
        indicator: int | None = None
        scalar: int | None = None
        commented = False
        while i < len(line):
            char = line[i]
            ahead = line[i + 1 : i + 2]
            if char in " \t":
                i += 1
                continue
            if char == "#":
                if i and line[i - 1] not in " \t":
                    raise LexError(offset + i, "'#' straight after a token")
                self.texts.append(Text(offset + i, offset + len(line), True))
                commented = True
                break
            if expect:
                if char in "-?:" and ahead in ("", " ", "\t"):
                    indicator = i
                    i += 1
                elif char in "'\"":
                    end = _yaml_closing(line, i + 1, char)
                    if end is None:
                        self.quote, self.quote_start = char, offset + i
                        self.plain = None
                        return
                    scalar, i, expect, last_plain = i, end, False, False
                elif char in "|>":
                    if flow:
                        raise LexError(offset + i, "block scalar in a flow collection")
                    self._block_header(line, offset, i, key, indicator)
                    return
                elif char in "&!":
                    while (
                        i < len(line)
                        and line[i] not in " \t"
                        and not (flow and line[i] in ",[]{}")
                    ):
                        i += 1
                elif char == "*":
                    end = _yaml_plain_end(line, i, flow)
                    i, expect, last_plain = end, False, False
                elif char in "[{":
                    if not self.flow:
                        self.flow_start = offset + i
                    self.flow += 1
                    flow = True
                    i += 1
                elif char in "]},":
                    if not flow:
                        raise LexError(
                            offset + i, f"{char!r} outside a flow collection"
                        )
                    if char == ",":
                        i += 1
                    else:
                        self.flow -= 1
                        flow = self.flow > 0
                        i, expect, last_plain = i + 1, False, False
                elif char in "@`":
                    raise LexError(offset + i, f"reserved indicator {char!r}")
                else:
                    scalar = i
                    i = _yaml_plain_end(line, i, flow)
                    expect, last_plain = False, True
            # In a flow collection a ':' may abut a quoted key, as in JSON.
            elif char == ":" and (
                ahead in ("", " ", "\t")
                or (flow and (ahead in tuple(",[]{}") or not last_plain))
            ):
                key = scalar if scalar is not None else indent
                i, expect = i + 1, True
            elif flow and char == ",":
                i, expect = i + 1, True
            elif flow and char in "]}":
                self.flow -= 1
                flow = self.flow > 0
                i += 1
            elif flow and last_plain:
                i = _yaml_plain_end(line, i, True)
            else:
                raise LexError(offset + i, f"unexpected {char!r} after a scalar")

        if flow:
            self.expect, self.last_plain = expect, last_plain
            self.plain = None
            return
        self.expect, self.last_plain = True, False
        if continuation:
            if commented:
                self.plain = None
        elif last_plain and not expect and not commented:
            if key is not None:
                self.plain = key
            else:
                self.plain = indicator if indicator is not None else -1
        else:
            self.plain = None

    def _block_header(
        self, line: str, offset: int, i: int, key: int | None, indicator: int | None
    ) -> None:
        header = _YAML_BLOCK_HEADER.match(line, i)
        if header is None:
            raise LexError(offset + i, "malformed block scalar header")
        if re.search(r"\d", header.group(1)):
            raise LexError(
                offset + i, "explicit indentation indicator, which this does not lex"
            )
        rest = line[header.end() :]
        comment = rest.lstrip(" \t")
        if comment and not comment.startswith("#"):
            raise LexError(offset + header.end(), "text after a block scalar header")
        if comment:
            start = offset + len(line) - len(comment)
            self.texts.append(Text(start, offset + len(line), True))
        if key is not None:
            parent = key
        elif indicator is not None:
            parent = indicator
        elif i == 0 or line.startswith("---"):
            parent = -1
        else:
            raise LexError(
                offset + i, "block scalar header with no key or indicator on its line"
            )
        self.block = (parent, None)
        self.plain = None


def yaml_texts(source: str) -> list[Text]:
    """Return the comments in YAML source."""
    return _Yaml(source).lex()


