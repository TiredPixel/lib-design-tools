# shellcheck shell=bash
#
# The example's settings for the runners in lib/design-tools/bin/: what each
# pass reads (lib/design-tools/README.md, Configuring the passes).
#
# Read only by the runners that source this one, so it looks unused here.
# shellcheck disable=SC2034
preview_index=/preview/

function palette_args {
    printf '%s\0' src/palette.yml --prefix ex --json src/palette.json \
        --css src/palette.css
}

function python_files {
    printf '%s\0' test/*.py
}

# Not src/palette.yml, whose key order is the order of the generated files.
function yaml_files {
    printf '%s\0' docker-compose.yml
}

function css_files {
    printf '%s\0' preview/*.css
}

function html_files {
    printf '%s\0' preview/*.html
}

function charset_files {
    printf '%s\0' preview/*.css src/palette.css
}

function references_args {
    printf '%s\0' --root . --no-external preview/*.html preview/*.css \
        src/palette.css
}

function comment_files {
    printf '%s\0' bin/format-paths src/palette.yml
    python_files
    yaml_files
    charset_files
}
